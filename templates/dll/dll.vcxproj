<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{fcba1469-6a37-4243-9325-8f60401c0435}</ProjectGuid>
    <TargetName>dll</TargetName>
    <UndockedType>dll</UndockedType>
    <UndockedDir>$(SolutionDir)..\</UndockedDir>
    <UndockedOut>$(SolutionDir)..\build\</UndockedOut>
    <!-- SourceLink is consumed via PackageReference (below) instead of the legacy packages folder. -->
    <UndockedSourceLink>false</UndockedSourceLink>
    <!-- Native projects trip a legacy NuGet asset-resolution task (Microsoft.NuGet.targets); disable it. -->
    <ResolveNuGetPackages>false</ResolveNuGetPackages>
  </PropertyGroup>
  <Import Project="$(UndockedDir)vs\windows.undocked.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="library.c" />
    <ResourceCompile Include="dll.rc" />
  </ItemGroup>
  <Import Project="$(UndockedDir)vs\windows.undocked.targets" />
</Project>
